{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MnM Loot Splitter",
  "version": "0.1.2",
  "identifier": "com.mnm-loot-spliter.register",
  "build": {
    "frontendDist": "../desktop/splash",
    "devUrl": "http://127.0.0.1:4721",
    "beforeDevCommand": "npm run wait:dev",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MnM Loot Splitter",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/register/**/*"
    ],
    "shortDescription": "Local loot splitter for Monsters & Memories",
    "longDescription": "Local tool that reads Ledger files already written by the Monsters & Memories client, with no injection or memory reading.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "MnM Loot Splitter"
      }
    }
  }
}
